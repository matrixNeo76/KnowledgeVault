rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Rules for user profile documents
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Rules for resources collection
    match /resources/{resourceId} {
      // Allow read if user owns the resource or if public/sample
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'anonymous' ||
        resource.data.isPublic == true
      );
      
      // Allow create if user sets themselves as owner and data is valid
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['article', 'github_repo', 'mcp_server', 'ai_skill', 'knowledge', 'link', 'troubleshooting']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 400;

      // Allow update if user owns it or for anonymous/migrated items
      allow update: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || resource.data.userId == 'anonymous' || !('userId' in resource.data))
        && request.resource.data.type in ['article', 'github_repo', 'mcp_server', 'ai_skill', 'knowledge', 'link', 'troubleshooting']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;

      // Allow delete if authenticated and user owns resource or for anonymous/migrated resources
      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || resource.data.userId == 'anonymous' || !('userId' in resource.data));
    }

    // Rules for raw_files collection (Staging buffer for PDF, images, TXT, MD)
    match /raw_files/{fileId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'anonymous'
      );
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.fileName is string;
      allow update: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || resource.data.userId == 'anonymous');
      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || resource.data.userId == 'anonymous');

      match /chunks/{chunkId} {
        allow read, write: if isAuthenticated();
      }
    }

    // System logs
    match /system_logs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
